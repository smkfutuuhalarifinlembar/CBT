# ===== Server (jangan commit file .env asli) =====
PORT=3000
NODE_ENV=production
APP_URL=https://ujian.sekolah.sch.id
ALLOWED_ORIGINS=https://ujian.sekolah.sch.id
# Kunci internal agar hanya frontend resmi yang bisa memanggil endpoint mutasi /api/db/*
ADMIN_API_KEY=isi-dengan-string-acak-min-32-karakter

# Kunci API Gemini (untuk koreksi essay otomatis). Kosongkan = pakai penilai fallback lokal.
GEMINI_API_KEY=

# ===== Database PostgreSQL lokal (WAJIB di server) =====
# Format: postgres://user:password@host:port/nama_database
# Buat dulu database-nya:  createdb ujian_cbt   (atau via pgAdmin/psql)
DATABASE_URL=postgres://ujian:rahasia@127.0.0.1:5432/ujian_cbt

# ===== Frontend (dibakar saat build via VITE_) =====
# HATI-HATI: nilai VITE_* terlihat di browser (bukan tempat secret!).
# DATABASE_URL / GEMINI_API_KEY TANPA awalan VITE_.
VITE_ADMIN_API_KEY=isi-sama-dengan-ADMIN_API_KEY-di-atas
# Opsional: akun admin darurat saat database masih kosong
VITE_BOOTSTRAP_ADMIN_EMAIL=
VITE_BOOTSTRAP_ADMIN_PASSWORD=


